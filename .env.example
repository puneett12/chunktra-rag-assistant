# Copy this file to .env and adjust. Every default below is free.

# ---- LLM (Ollama, running locally) ----
# Install: https://ollama.com  then:  ollama pull qwen2.5:7b-instruct
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
# 8 GB RAM machine? Use a smaller model instead:
# LLM_MODEL=llama3.2:3b

# ---- Embeddings (downloaded once, then fully offline) ----
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base

# ---- Retrieval tuning ----
CHUNK_SIZE=900            # characters per chunk (roughly 200 tokens)
CHUNK_OVERLAP=150
CONTEXTUAL_HEADERS=true   # prefix chunks with document + section; re-ingest after changing
CANDIDATES=30             # how many chunks hybrid search hands to the reranker
TOP_K=5                   # how many survive and go into the prompt

# ---- Paths ----
RAW_DIR=data/raw
INDEX_DIR=data/processed

# ---- SEC EDGAR requires a contact email in the User-Agent header ----
EDGAR_USER_AGENT=your.name@example.com
